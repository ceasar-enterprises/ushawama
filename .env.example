# Ushawama app config - copy to .env and adjust for your machine.
# .env is git-ignored; never commit real keys.

# API base the app talks to. Use your PC's LAN IP so phones on the same
# Wi-Fi can reach the API (localhost will not work from a phone).
EXPO_PUBLIC_USHAWAMA_API=http://YOUR-LAN-IP:4000

# --- NLU spine (optional) -------------------------------------------------
# Provider: gemini (default) or ollama. With no key the app falls back to its
# built-in regex parser, so voice input still works offline.
SPINE_PROVIDER=gemini
# Read the key from the environment or point at an env file:
GEMINI_API_KEY=
SPINE_KEY_PATH=
AGENT_ENV_PATH=
SPINE_MODEL=gemini-3.5-flash-lite
# For a local Ollama instance:
OLLAMA_URL=http://localhost:11434

# --- Corridor event bridge (optional) -------------------------------------
# Forwards escrow/tracking events to the NEBULA engine. Disabled with
# NEBULA_ENABLED=false. Requires NEBULA_API_KEY.
NEBULA_ENABLED=false
NEBULA_API_BASE=https://localhost:8080
NEBULA_API_KEY=
NEBULA_CONFIG_PATH=
# Allow self-signed certificates (local development only).
NEBULA_TLS_INSECURE=false

# --- API ------------------------------------------------------------------
PORT=4000
